> from __future__ import annotations
  
> import contextlib
> import csv
> import io
> import logging
> from pathlib import Path
  
> from pypdf import PdfReader
  
> from home_llm.models import DocumentChunk
  
> logging.getLogger("pypdf").setLevel(logging.ERROR)
  
  
> def read_document(path: Path) -> list[DocumentChunk]:
>     suffix = path.suffix.lower()
>     if suffix == ".pdf":
>         return _read_pdf(path)
>     if suffix in {".txt", ".md"}:
>         text = path.read_text(encoding="utf-8", errors="ignore")
>         return [
>             DocumentChunk(
>                 file_path=str(path),
>                 doc_type=_guess_doc_type(path),
>                 page_label="full",
>                 content=text,
>             )
>         ]
>     if suffix == ".csv":
>         return _read_csv(path)
>     raise ValueError(f"Unsupported file type: {path}")
  
  
> def _read_pdf(path: Path) -> list[DocumentChunk]:
>     with contextlib.redirect_stderr(io.StringIO()):
>         reader = PdfReader(str(path))
>     chunks: list[DocumentChunk] = []
>     doc_type = _guess_doc_type(path)
>     for index, page in enumerate(reader.pages, start=1):
>         try:
>             with contextlib.redirect_stderr(io.StringIO()):
>                 text = page.extract_text() or ""
>         except Exception as exc:  # noqa: BLE001
>             logging.getLogger("pypdf").warning(
>                 "Failed to extract text from %s page %s: %s",
>                 path,
>                 index,
>                 exc,
>             )
>             text = ""
>         if text.strip():
>             chunks.append(
>                 DocumentChunk(
>                     file_path=str(path),
>                     doc_type=doc_type,
>                     page_label=f"page {index}",
>                     content=text,
>                 )
>             )
>     return chunks
  
  
> def _read_csv(path: Path) -> list[DocumentChunk]:
>     rows: list[str] = []
>     with path.open("r", encoding="utf-8", errors="ignore", newline="") as handle:
>         reader = csv.reader(handle)
>         for row in reader:
>             rows.append(", ".join(cell.strip() for cell in row if cell.strip()))
>     return [
>         DocumentChunk(
>             file_path=str(path),
>             doc_type=_guess_doc_type(path),
>             page_label="full",
>             content="\n".join(rows),
>         )
>     ]
  
  
> def _guess_doc_type(path: Path) -> str:
>     name = str(path).lower()
>     checks = [
>         ("mortgage", "mortgage"),
>         ("loan", "loan"),
>         ("insurance", "insurance"),
>         ("brokerage", "investment"),
>         ("invest", "investment"),
>         ("retirement", "retirement"),
>         ("bank", "bank"),
>         ("statement", "statement"),
>         ("policy", "insurance"),
>     ]
>     for needle, label in checks:
>         if needle in name:
>             return label
>     return "document"
